# Server-side secrets — set these in Vercel (and .env.local for dev). Never commit values.

# Anthropic API key for the LLM routes (portrait synthesis, chat, parsing).
ANTHROPIC_API_KEY=

# TMDB API key for the movie/TV metadata proxy.
TMDB_API_KEY=

# Passphrase required in a request header to use the LLM route; set the same value once on your phone.
NIGHTSTAND_PASSPHRASE=
